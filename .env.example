# .env.example — ClipVault 环境变量模板。
#
# 用法：复制为 .env 后填入自己的值（.env 已被 .gitignore，不会进仓库）。
# 说明：所有 AI 相关变量都是可选的；不配置则 AI 功能自动关闭，
#       采集、存储、关键词搜索等核心功能完全不受影响。
#       系统环境变量优先级高于 .env 文件。

# ---------------------------------------------------------------------------
# 数据目录
# ---------------------------------------------------------------------------

# 数据目录（数据库 + 图片）。默认 <项目根>/clipboard_data
# CLIPVAULT_DATA_DIR=D:/data/clipvault

# ---------------------------------------------------------------------------
# AI 能力（可选）：OpenAI 兼容接口
#
# 注意：推荐在界面「AI 设置」窗口里配置，保存到 clipboard_data/settings.json。
# 本文件的优先级低于界面设置（界面 > 环境变量/.env > 默认值），
# 适合脚本/部署场景；想锁定配置时先清空界面里的 AI 设置。
# ---------------------------------------------------------------------------

# 总开关：1=开启（默认），0=完全关闭 AI（即使配了 Key 也不调用）
# CLIPVAULT_AI_ENABLED=1

# API Key：只从环境变量读取，绝不硬编码进代码
# CLIPVAULT_AI_API_KEY=sk-your-key-here

# 接口地址：任何 OpenAI 兼容服务（官方 / Azure 代理 / 本地 vLLM / Ollama 等）
# CLIPVAULT_AI_BASE_URL=https://api.openai.com/v1

# 分类模型与向量模型
# CLIPVAULT_AI_CHAT_MODEL=gpt-4o-mini
# CLIPVAULT_AI_EMBED_MODEL=text-embedding-3-small

# 候选分类（逗号分隔），用于新文本自动打标签
# CLIPVAULT_AI_CATEGORIES=链接,代码,命令,邮箱电话,地址,账号凭证,笔记,其他

# 单次请求超时（秒）
# CLIPVAULT_AI_TIMEOUT=10
