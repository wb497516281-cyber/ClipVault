# .gitattributes — 统一行尾，避免 Windows/Mac/Linux 协作者出现整文件 diff
# 代码与文档统一按 LF 入库；Windows 上检出为 CRLF 由 git 自动处理
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
*.mjs text eol=lf
*.spec text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf

# 二进制文件不做行尾转换
*.png binary
*.ico binary
